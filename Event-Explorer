local function ExecuteExtracted(CodeString: string)
	if not CodeString or CodeString == "" then return end

	local Payloads = {}
	local BlockStack = {}
	local BlockDepth = 0

	local function HasRemoteTrigger(Code: string): boolean
		for _, Trigger in IPairs(RemoteTriggers) do
			if StrFind(Code, Trigger, 1, true) then
				return true
			end
		end
		return false
	end

	local CodeLines = {}
	for Line in StrGmatch(CodeString, "[^\n]+") do
		TableInsert(CodeLines, StrMatch(Line, "^%s*(.-)%s*$"))
	end

	local LineIndex = 1
	while LineIndex <= #CodeLines do
		local Line = CodeLines[LineIndex]
		
		if Line ~= "" and Line ~= "-- No events in this script found." and Line ~= "-- Failed to decompile this script." and not StrMatch(Line, "^%-%-") then
			if StrMatch(Line, "%f[%a]do%f[%A]") or StrMatch(Line, "%f[%a]then%f[%A]") or StrMatch(Line, "^for%s") or StrMatch(Line, "^if%s") then
				BlockDepth = BlockDepth + 1
				TableInsert(BlockStack, Line)
			elseif Line == "end" then
				BlockDepth = BlockDepth - 1
				TableInsert(BlockStack, Line)
				
				if BlockDepth == 0 then
					local Block = table.concat(BlockStack, "\n")
					if HasRemoteTrigger(Block) then
						TableInsert(Payloads, Block)
					end
					BlockStack = {}
				end
			else
				if BlockDepth > 0 then
					TableInsert(BlockStack, Line)
				elseif HasRemoteTrigger(Line) then
					TableInsert(Payloads, Line)
				end
			end
		end
		LineIndex = LineIndex + 1
	end

	if #BlockStack > 0 then
		local Block = table.concat(BlockStack, "\n")
		if HasRemoteTrigger(Block) then
			TableInsert(Payloads, Block)
		end
	end

	local PCCall = PCCall or function(func, ...)
    local success, result = pcall(func, ...)
    return success, result
end

	if #Payloads == 0 then
		local Simplified = SimplifyCode(CodeString)
		Simplified = StrReplace(Simplified, "script%.", "scriptpath.")
		local Compiled = loadstring(Simplified)
		if Compiled then
			PCCall(Compiled)
		end
		return
	end

	for _, Payload in IPairs(Payloads) do
		local Simplified = SimplifyCode(Payload)
		Simplified = StrReplace(Simplified, "script%.", "scriptpath.")
		
		local Compiled = loadstring(Simplified)
		if Compiled then
			task.spawn(function()
				PCCall(Compiled)
			end)
		end
	end
end

