local function RefreshScripts()
	for _, Item in IPairs(ScriptList) do
		if Item.Log then Item.Log:Destroy() end
	end

	TableClear(ScriptList)
	TableClear(ScriptCache)

	CurrentSelection = nil
	EventsView.CanvasSize = UDim2.fromOffset(0, 0)
	ScriptsList.CanvasSize = UDim2.fromOffset(0, 0)
	NextLayout = math.huge

	local Found = {}
	local SearchSuccess = PCall(function()
		for _, Service in IPairs(game:GetChildren()) do
			local ServiceClass = Service.ClassName
			if ServiceClass ~= "CoreGui" and ServiceClass ~= "CorePackages" and ServiceClass ~= "LocalSaves" and ServiceClass ~= "StarterGui" then
				for _, Descendant in IPairs(Service:GetDescendants()) do
					if not IsInCore(Descendant) then
						local IsLocalScript = Descendant:IsA("LocalScript")
						local IsModuleScript = Descendant:IsA("ModuleScript")
						
						if IsLocalScript and not ExcludedScriptNames[Descendant.Name] then
							TableInsert(Found, Descendant)
						elseif IsModuleScript and not ExcludedModuleNames[Descendant.Name] then
							TableInsert(Found, Descendant)
						end
					end
				end
			end
		end
	end)

	if #Found == 0 then
		EventsOutput.Text = "No scripts found inside the game."
		AddLog("No scripts found.")
		return
	end

	for _, FoundScript in IPairs(Found) do
		AddScript(FoundScript)
	end

	EventsOutput.Text = "Select a script from script logs."
	UpdateSearch()
	AddLog("Refreshed script logs.")
end

