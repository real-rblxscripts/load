local IsDragging = false
local DragStart = nil
local DragOffset = nil

HeaderFrame.InputBegan:Connect(function(Input)
	if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
		IsDragging = true
		DragStart = Input.Position
		DragOffset = MainFrame.Position

		Input.Changed:Connect(function()
			if Input.UserInputState == Enum.UserInputState.End then
				IsDragging = false
			end
		end)
	end
end)

InputService.InputChanged:Connect(function(Input)
	if not IsDragging then return end
	if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
		local Delta = Input.Position - DragStart
		MainFrame.Position = UDim2.new(
			DragOffset.X.Scale,
			DragOffset.X.Offset + Delta.X,
			DragOffset.Y.Scale,
			DragOffset.Y.Offset + Delta.Y
		)
	end
end)

local IsResizing = false
local ResizeStart = nil
local ResizeSize = nil
TableInsert(AllConnections, ResizeHandle.InputBegan:Connect(function(Input)
	if (Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch) and not IsMinimized then
		IsResizing = true
		ResizeStart = Input.Position
		ResizeSize = MainFrame.Size

		Input.Changed:Connect(function()
			if Input.UserInputState == Enum.UserInputState.End then
				IsResizing = false
				if not IsMinimized then
					MinimumSize = Vector2.new(MainFrame.Size.X.Offset, MainFrame.Size.Y.Offset)
				end
			end
		end)
	end
end))

TableInsert(AllConnections, InputService.InputChanged:Connect(function(Input)
	if IsResizing and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
		local Delta = Input.Position - ResizeStart
		local MinWidth = 400
		local NewWidth = MathMax(MinWidth, ResizeSize.X.Offset + Delta.X)
		local NewHeight = MathMax(250, ResizeSize.Y.Offset + Delta.Y)
		MainFrame.Size = UDim2.new(0, NewWidth, 0, NewHeight)
	end
end))

local function ToggleMinimize()
	if MainFrame.Size.X.Offset == 0 then return end
	IsMinimized = not IsMinimized
	if IsMinimized then
		ApplyTween(ScriptsPanel, {BackgroundTransparency = 1})
		ApplyTween(EventsPanel, {BackgroundTransparency = 1})
		ApplyTween(LogsPanel, {BackgroundTransparency = 1})
		ScriptsPanel.Visible = false
		EventsPanel.Visible = false
		LogsPanel.Visible = false
		ResizeHandle.Visible = false
		MainFrame:TweenSize(UDim2.new(0, MainFrame.Size.X.Offset, 0, 52), "Out", "Quad", 0.15, true)
		HeaderUnderline.Visible = false
	else
		ScriptsPanel.Visible = true
		EventsPanel.Visible = true
		LogsPanel.Visible = true
		ResizeHandle.Visible = true
		ApplyTween(ScriptsPanel, {BackgroundTransparency = 0})
		ApplyTween(EventsPanel, {BackgroundTransparency = 0})
		ApplyTween(LogsPanel, {BackgroundTransparency = 0})
		MainFrame:TweenSize(UDim2.new(0, MinimumSize.X, 0, MinimumSize.Y), "Out", "Quad", 0.15, true)
		HeaderUnderline.Visible = true
	end
end

local function ShowTooltip(ShouldShow: boolean, Message: string?)
	if ShouldShow and Message then
		if Tooltip.Visible then
			local Connection = TooltipState["Connection"]
			if Connection then Connection:Disconnect() end
		end
		local FirstUpdate = true
		TooltipState["Connection"] = RunService.RenderStepped:Connect(function()
			local MousePos = InputService:GetMouseLocation()
			local TooltipPos = MousePos + Vector2.new(15, -10)
			local TooltipEnd = TooltipPos + Tooltip.AbsoluteSize
			local ViewportSize = workspace.CurrentCamera.ViewportSize
			local MaxX = ViewportSize.X
			local MaxY = ViewportSize.Y

			if TooltipPos.X < 0 then
				TooltipPos = Vector2.new(0, TooltipPos.Y)
			elseif TooltipEnd.X > MaxX then
				TooltipPos = Vector2.new(MaxX - Tooltip.AbsoluteSize.X, TooltipPos.Y)
			end
			if TooltipPos.Y < 0 then
				TooltipPos = Vector2.new(TooltipPos.X, 0)
			elseif TooltipEnd.Y > MaxY - 35 then
				TooltipPos = Vector2.new(TooltipPos.X, MaxY - Tooltip.AbsoluteSize.Y - 35)
			end
			if TooltipPos.X <= MousePos.X and TooltipPos.Y <= MousePos.Y then
				TooltipPos = Vector2.new(MousePos.X - Tooltip.AbsoluteSize.X - 2, MousePos.Y - Tooltip.AbsoluteSize.Y - 2)
			end
			if FirstUpdate then
				Tooltip.Position = UDim2.fromOffset(TooltipPos.X, TooltipPos.Y)
				FirstUpdate = false
			else
				Tooltip.Position = UDim2.fromOffset(TooltipPos.X, TooltipPos.Y)
			end
		end)
		TooltipText.Text = Message
		TooltipText.TextScaled = true
		Tooltip.Visible = true
		ApplyTween(Tooltip, {BackgroundTransparency = 0.05})
		ApplyTween(TooltipText, {TextTransparency = 0})
	else
		if Tooltip.Visible then
			local Connection = TooltipState["Connection"]
			if Connection then Connection:Disconnect() end
			Tooltip.Visible = false
			Tooltip.BackgroundTransparency = 1
			TooltipText.TextTransparency = 1
		end
	end
end

