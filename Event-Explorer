local function AddLog(Message: string)
	local CurrentText = LogsOutput.Text
	local TimeStr = os.date("%H:%M:%S")
	local Timestamp = "[" .. TimeStr .. "] " .. Message
	
	if CurrentText == "" then
		LogsOutput.Text = Timestamp
	else
		LogsOutput.Text = CurrentText .. "\n" .. Timestamp
	end
	
	local TextSize = TextService:GetTextSize(LogsOutput.Text, LogsOutput.TextSize, LogsOutput.Font, Vector2.new(342, math.huge))
	LogsView.CanvasSize = UDim2.fromOffset(0, TextSize.Y + 12)
	LogsView.CanvasPosition = Vector2.new(0, TextSize.Y)
end

local function RearrangeLayout()
	if IsMinimized then
		return
	end

	local FrameWidth = MainFrame.AbsoluteSize.X
	local FrameHeight = MainFrame.AbsoluteSize.Y

	local Padding = 6
	local LeftWidth = 140
	local RightWidth = 286

	local MiddleWidth = MathMax(180, FrameWidth - LeftWidth - RightWidth - (Padding * 5))

	ScriptsPanel.Position = UDim2.fromOffset(Padding, 58)
	ScriptsPanel.Size = UDim2.fromOffset(LeftWidth, FrameHeight - 64)

	EventsPanel.Position = UDim2.fromOffset(LeftWidth + (Padding * 2), 58)
	EventsPanel.Size = UDim2.fromOffset(MiddleWidth, FrameHeight - 64)

	LogsPanel.Position = UDim2.fromOffset(
		LeftWidth + MiddleWidth + (Padding * 3),
		58
	)
	LogsPanel.Size = UDim2.fromOffset(RightWidth, FrameHeight - 64)

	LogsView.Size = UDim2.fromOffset(RightWidth - 12, FrameHeight - 98)

	EventsView.Size = UDim2.fromOffset(
		MiddleWidth - 12,
		MathMax(100, FrameHeight - 242)
	)

	ParametersView.Position = UDim2.fromOffset(
		6,
		EventsView.Position.Y.Offset + EventsView.Size.Y.Offset + 8
	)

	ParametersView.Size = UDim2.fromOffset(
		MiddleWidth - 12,
		MathMax(60, FrameHeight - ParametersView.Position.Y.Offset - 6)
	)

	ResizeHandle.Position = UDim2.new(1, -12, 1, -12)
end

