local function IsInCore(Instance: Instance): boolean
	local Current = Instance
	while Current and Current ~= game do
		local Parent = Current.Parent
		if Parent then
			local ClassName = Parent.ClassName
			if ClassName == "CoreGui" or ClassName == "CorePackages" or ClassName == "LocalSaves" then
				return true
			end
		end
		Current = Parent
	end
	return false
end

local function Create(ClassName: string, Properties: { [string]: any }?, Children: { Instance }?): Instance
	local Instance = Instance.new(ClassName)
	for Key, Value in NextPair, Properties or {} do
		Instance[Key] = Value
	end
	for _, Child in NextPair, Children or {} do
		Child.Parent = Instance
	end
	return Instance
end

local function GetInstancePath(Instance: Instance): string
	if not Instance then return "nil" end
	local PathParts = {}
	local Current = Instance

	while Current and Current ~= game do
		local Name = Current.Name
		if StrMatch(Name, "^[%a_][%w_]*$") then
			TableInsert(PathParts, 1, Name)
		else
			local Escaped = StrReplace(Name, '"', '\\"')
			TableInsert(PathParts, 1, '["' .. Escaped .. '"]')
		end
		Current = Current.Parent
	end

	local Path = "game"
	for _, Part in IPairs(PathParts) do
		if StrSub(Part, 1, 1) == "[" then
			Path = Path .. Part
		else
			Path = Path .. "." .. Part
		end
	end
	return Path
end

local function Tokenize(Code: string): { { Type: string, Value: string } }
	local Tokens = {}
	local Length = #Code
	local Index = 1

	while Index <= Length do
		local Char = StrSub(Code, Index, Index)

		if StrMatch(Char, "%s") then
			local Start = Index
			while Index <= Length and StrMatch(StrSub(Code, Index, Index), "%s") do
				Index = Index + 1
			end
			TableInsert(Tokens, {Type = "Whitespace", Value = StrSub(Code, Start, Index - 1)})
		elseif Char == '"' or Char == "'" then
			local Start = Index
			local QuoteChar = Char
			Index = Index + 1
			while Index <= Length do
				local Current = StrSub(Code, Index, Index)
				if Current == QuoteChar and StrSub(Code, Index - 1, Index - 1) ~= "\\" then
					Index = Index + 1
					break
				end
				Index = Index + 1
			end
			TableInsert(Tokens, {Type = "String", Value = StrSub(Code, Start, Index - 1)})
		elseif StrSub(Code, Index, Index + 1) == "--" then
			local EndPos = StrFind(Code, "\n", Index) or Length + 1
			TableInsert(Tokens, {Type = "Comment", Value = StrSub(Code, Index, EndPos - 1)})
			Index = EndPos
		elseif StrSub(Code, Index, Index + 3) == "--[[" then
			local Start = Index
			Index = Index + 4
			while Index <= Length - 1 do
				if StrSub(Code, Index, Index + 1) == "]]" then
					Index = Index + 2
					break
				end
				Index = Index + 1
			end
			TableInsert(Tokens, {Type = "BlockComment", Value = StrSub(Code, Start, Index - 1)})
		elseif StrMatch(Char, "[%a_]") then
			local Start = Index
			while Index <= Length and StrMatch(StrSub(Code, Index, Index), "[%w_]") do
				Index = Index + 1
			end
			TableInsert(Tokens, {Type = "Identifier", Value = StrSub(Code, Start, Index - 1)})
		elseif StrMatch(Char, "[%d]") then
			local Start = Index
			while Index <= Length and StrMatch(StrSub(Code, Index, Index), "[%x%.%e%E%+%-]") do
				Index = Index + 1
			end
			TableInsert(Tokens, {Type = "Number", Value = StrSub(Code, Start, Index - 1)})
		elseif Index < Length then
			local TwoChar = StrSub(Code, Index, Index + 1)
			if TwoChar == "==" or TwoChar == "~=" or TwoChar == "<=" or TwoChar == ">=" or TwoChar == ".." or TwoChar == "::" then
				TableInsert(Tokens, {Type = "Operator", Value = TwoChar})
				Index = Index + 2
			else
				TableInsert(Tokens, {Type = "Symbol", Value = Char})
				Index = Index + 1
			end
		else
			TableInsert(Tokens, {Type = "Symbol", Value = Char})
			Index = Index + 1
		end
	end

	return Tokens
end

local function RemoveComments(Tokens: { { Type: string, Value: string } }): string
	local Result = {}
	for Index = 1, #Tokens do
		local Token = Tokens[Index]
		if Token.Type ~= "Comment" and Token.Type ~= "BlockComment" then
			TableInsert(Result, Token.Value)
		end
	end
	return table.concat(Result)
end

local function ValidatePath(Tokens: { { Type: string, Value: string } }): boolean
	if not Tokens or #Tokens == 0 then return false end

	local FirstValue = Tokens[1].Value
	local IsValid = (FirstValue == "game" or FirstValue == "workspace" or FirstValue == "script")

	if not IsValid and ServiceNames[FirstValue] then
		IsValid = true
	end

	if not IsValid then return false end

	for Index = 1, #Tokens do
		local Token = Tokens[Index]
		if Token.Type == "Symbol" or Token.Type == "Operator" then
			local Value = Token.Value
			if Value == ":" or Value == "(" or Value == ")" or Value == "[" or Value == "]" or
			   Value == "+" or Value == "-" or Value == "*" or Value == "/" or Value == "^" or Value == "#" or
			   Value == "==" or Value == "~=" then
				return false
			end
		end
	end

	for Index = 1, #Tokens - 2 do
		if Tokens[Index].Type == "Identifier" and Tokens[Index+1].Value == "." then
			local Name = Tokens[Index].Value
			if TypeNames[Name] then
				return false
			end
		end
	end

	return true
end

local function OptimizeGetService(Expression: string): string
	if not Expression or Expression == "" then return "" end

	local Tokens = Tokenize(Expression)
	if not ValidatePath(Tokens) then
		return Expression
	end

	local ServiceMatch = StrMatch(Expression, "^game%s*:%s*GetService%s*%(\"([^\"]+)\"%)")

	local Result = Expression
	local Base = ""

	if ServiceMatch then
		Base = 'game:GetService("' .. ServiceMatch .. '")'
		local MatchLen = #StrMatch(Expression, "^game%s*:%s*GetService%s*%(\"[^\"]+\"%)")
		Result = StrSub(Expression, MatchLen + 1)
	else
		local ServiceName = nil
		for Service in Pairs(ServiceNames) do
			if StrSub(Expression, 1, #("game." .. Service)) == "game." .. Service then
				ServiceName = Service
				break
			end
		end

		if ServiceName then
			Base = 'game:GetService("' .. ServiceName .. '")'
			Result = StrSub(Expression, #("game." .. ServiceName) + 1)
		elseif StrSub(Expression, 1, 5) == "game." then
			Base = 'game'
			Result = StrSub(Expression, 5)
		end
	end

	for Part in StrGmatch(Result, "[^%.]+") do
		if Part ~= "" then
			if Base == "" then
				Base = Part
			else
				if StrMatch(Part, "^[%a_][%w_]*$") then
					Base = Base .. ':FindFirstChild("' .. Part .. '")'
				else
					Base = Base .. '.' .. Part
				end
			end
		end
	end

	return Base ~= "" and Base or Expression
end

local function UnquoteString(Str: string): string
	if not Str then return "" end
	local Unquoted = StrMatch(Str, "^%s*['\"](.*)['\"]%s*$")
	return Unquoted or Str
end

local function SplitArguments(ArgumentString: string): { string }
	local Result = {}
	local Current = ""
	local Depth = 0
	local InString = false
	local StringChar = nil

	for Index = 1, #ArgumentString do
		local Char = StrSub(ArgumentString, Index, Index)
		if InString then
			if Char == StringChar and StrSub(ArgumentString, Index - 1, Index - 1) ~= "\\" then
				InString = false
			end
			Current = Current .. Char
		elseif Char == '"' or Char == "'" then
			InString = true
			StringChar = Char
			Current = Current .. Char
		elseif Char == "(" or Char == "{" or Char == "[" then
			Depth = Depth + 1
			Current = Current .. Char
		elseif Char == ")" or Char == "}" or Char == "]" then
			Depth = Depth - 1
			Current = Current .. Char
		elseif Char == "," and Depth == 0 then
			TableInsert(Result, StrMatch(Current, "^%s*(.-)%s*$"))
			Current = ""
		else
			Current = Current .. Char
		end
	end
	TableInsert(Result, StrMatch(Current, "^%s*(.-)%s*$"))
	return Result
end

local function FindCalls(Code: string): { { name: string, args: string } }
	local Calls = {}
	local StartPos = 1
	while StartPos <= #Code do
		local Begin, End, Name = StrFind(Code, "([%a_][%w_]*)%s*%(", StartPos)
		if not Begin then break end

		local Depth = 1
		local ArgStart = End + 1
		local ArgEnd = nil
		local Pos = ArgStart
		local InString = false
		local StringChar = nil

		while Pos <= #Code do
			local Char = StrSub(Code, Pos, Pos)
			if InString then
				if Char == StringChar and StrSub(Code, Pos - 1, Pos - 1) ~= "\\" then
					InString = false
				end
			elseif Char == '"' or Char == "'" then
				InString = true
				StringChar = Char
			elseif Char == "(" then
				Depth = Depth + 1
			elseif Char == ")" then
				Depth = Depth - 1
				if Depth == 0 then
					ArgEnd = Pos - 1
					break
				end
			end
			Pos = Pos + 1
		end

		if ArgEnd then
			local Args = StrSub(Code, ArgStart, ArgEnd)
			TableInsert(Calls, {name = Name, args = Args})
			StartPos = Pos + 1
		else
			StartPos = End + 1
		end
	end
	return Calls
end

local function FuzzyScore(Needle: string, Haystack: string): number
	local NeedleLen = #Needle
	local HaystackLen = #Haystack
	if NeedleLen == 0 then return 1 end
	if HaystackLen < NeedleLen then return 0 end
	local NeedlePos = 1
	local Score = 0
	local LastMatch = 0
	for HayPos = 1, HaystackLen do
		local HayChar = StrSub(Haystack, HayPos, HayPos)
		local NeedleChar = StrSub(Needle, NeedlePos, NeedlePos)
		if HayChar == NeedleChar then
			if LastMatch > 0 and HayPos == LastMatch + 1 then
				Score = Score + 15
			else
				Score = Score + 5
			end
			LastMatch = HayPos
			NeedlePos = NeedlePos + 1
			if NeedlePos > NeedleLen then
				return Score + (HaystackLen - HayPos) * 0.1
			end
		end
	end
	return 0
end

local function SearchRelevance(Item: { ScriptNameLower: string, LogNameLower: string, ModuleNameLower: string }, Query: string): number
	if Query == "" then return 0 end
	local ScriptLower = Item.ScriptNameLower or ""
	local LogLower = Item.LogNameLower or ""
	local ModuleLower = Item.ModuleNameLower or ""

	if ScriptLower == Query or LogLower == Query or ModuleLower == Query then
		return 10000
	end

	if StrSub(ScriptLower, 1, #Query) == Query or StrSub(LogLower, 1, #Query) == Query or StrSub(ModuleLower, 1, #Query) == Query then
		return 8000
	end

	local Pattern = "%f[%w_]" .. Query
	if StrFind(ScriptLower, Pattern) or StrFind(LogLower, Pattern) or StrFind(ModuleLower, Pattern) then
		return 6000
	end

	if StrFind(ScriptLower, Query, 1, true) or StrFind(LogLower, Query, 1, true) or StrFind(ModuleLower, Query, 1, true) then
		return 4000
	end

	local Score1 = FuzzyScore(Query, ScriptLower)
	local Score2 = FuzzyScore(Query, LogLower)
	local Score3 = FuzzyScore(Query, ModuleLower)
	local MaxScore = MathMax(Score1, Score2, Score3)
	if MaxScore > 0 then
		return 1000 + MaxScore
	end

	return 0
end

