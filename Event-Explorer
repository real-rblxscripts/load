local function ResolveVariables(Code: string, Variables: { [string]: string }): string
	local Iterations = 0
	local Replacements = {}

	repeat
		local Changed = false
		local Tokens = Tokenize(Code)
		local NewTokens = {}
		local TokenCount = #Tokens
		local TokenIndex = 1

		while TokenIndex <= TokenCount do
			local Token = Tokens[TokenIndex]
			if Token.Type == "Identifier" and not GlobalNames[Token.Value] then
				local Name = Token.Value
				local Replacement = Variables[Name]

				if Replacement and Replacement ~= "nil" and Replacement ~= "" and not Replacements[Name] then
					local IsAfterDot = false

					local PrevIndex = TokenIndex - 1
					while PrevIndex >= 1 and Tokens[PrevIndex].Type == "Whitespace" do
						PrevIndex = PrevIndex - 1
					end
					if PrevIndex >= 1 and (Tokens[PrevIndex].Type == "Symbol" or Tokens[PrevIndex].Type == "Operator") and (Tokens[PrevIndex].Value == "." or Tokens[PrevIndex].Value == ":") then
						IsAfterDot = true
					end

					if not IsAfterDot then
						local IsBuiltinCall = false
						local CheckIndex = PrevIndex
						if CheckIndex >= 1 and Tokens[CheckIndex].Type == "Symbol" and Tokens[CheckIndex].Value == "(" then
							CheckIndex = CheckIndex - 1
							while CheckIndex >= 1 and Tokens[CheckIndex].Type == "Whitespace" do
								CheckIndex = CheckIndex - 1
							end
							if CheckIndex >= 1 and Tokens[CheckIndex].Type == "Identifier" and GlobalNames[Tokens[CheckIndex].Value] then
								IsBuiltinCall = true
							end
						end

						if not IsBuiltinCall then
							local NextIndex = TokenIndex + 1
							while NextIndex <= TokenCount and Tokens[NextIndex].Type == "Whitespace" do
								NextIndex = NextIndex + 1
							end

							local IsSpecialCall = false
							if NextIndex <= TokenCount and Tokens[NextIndex].Type == "Symbol" and Tokens[NextIndex].Value == "(" then
								if Name == "WaitForChild" or Name == "FindFirstChild" or StrFind(Replacement, "^game:GetService") or StrFind(Replacement, "^game%.") then
									IsSpecialCall = true
								end
							end

							if not IsSpecialCall then
								Token.Value = Replacement
								Changed = true
								Replacements[Name] = true
							end
						end
					end
				end
			end
			TableInsert(NewTokens, Token)
			TokenIndex = TokenIndex + 1
		end

		if Changed then
			Code = RemoveComments(NewTokens)
		end
		Iterations = Iterations + 1
	until not Changed or Iterations > 20

	return StrMatch(Code, "^%s*(.-)%s*$")
end

local function OptimizeScript(Code: string, Variables: { [string]: string }, BasePath: string): string
	local Tokens = Tokenize(Code)
	local TokenCount = #Tokens
	local TokenIndex = 1

	while TokenIndex <= TokenCount do
		local Token = Tokens[TokenIndex]
		if Token.Type == "Identifier" then
			if Token.Value == "script" then
				local IsAfterDot = false
				local PrevIndex = TokenIndex - 1
				while PrevIndex >= 1 and Tokens[PrevIndex].Type == "Whitespace" do
					PrevIndex = PrevIndex - 1
				end
				if PrevIndex >= 1 and (Tokens[PrevIndex].Type == "Symbol" or Tokens[PrevIndex].Type == "Operator") and (Tokens[PrevIndex].Value == "." or Tokens[PrevIndex].Value == ":") then
					IsAfterDot = true
				end

				if not IsAfterDot then
					local NextIndex = TokenIndex + 1
					local ParentCount = 0
					while NextIndex <= TokenCount do
						if Tokens[NextIndex].Type == "Whitespace" then
							NextIndex = NextIndex + 1
						elseif (Tokens[NextIndex].Type == "Symbol" or Tokens[NextIndex].Type == "Operator") and Tokens[NextIndex].Value == "." then
							local CheckIndex = NextIndex + 1
							while CheckIndex <= TokenCount and Tokens[CheckIndex].Type == "Whitespace" do
								CheckIndex = CheckIndex + 1
							end
							if CheckIndex <= TokenCount and Tokens[CheckIndex].Type == "Identifier" and Tokens[CheckIndex].Value == "Parent" then
								ParentCount = ParentCount + 1
								NextIndex = CheckIndex + 1
							else
								break
							end
						else
							break
						end
					end

					local PathParts = {}
					local ServiceMatch = StrMatch(BasePath, "^game%s*:%s*GetService%s*%(\"[^\"]+\"%)")
					local ServiceCall = StrMatch(BasePath, "^game%s*:%s*GetService%s*%(\"[^\"]+\"%)") or "game"
					local RemainingPath = StrSub(BasePath, #ServiceCall + 1)
					for Part in StrGmatch(RemainingPath, 'FindFirstChild%s*%("%s*([^"]+)%s*"%)') do
						TableInsert(PathParts, Part)
					end

					local TotalParts = #PathParts
					local TargetParts = TotalParts - ParentCount

					local ScriptPath = ServiceCall
					for PartIndex = 1, TargetParts do
						ScriptPath = ScriptPath .. ':FindFirstChild("' .. PathParts[PartIndex] .. '")'
					end

					Token.Value = ScriptPath

					if ParentCount > 0 then
						local ClearIndex = TokenIndex + 1
						local ClearedParents = 0
						while ClearIndex <= TokenCount and ClearedParents < ParentCount do
							if (Tokens[ClearIndex].Type == "Symbol" or Tokens[ClearIndex].Type == "Operator") and Tokens[ClearIndex].Value == "." then
								Tokens[ClearIndex].Value = ""
							elseif Tokens[ClearIndex].Type == "Identifier" and Tokens[ClearIndex].Value == "Parent" then
								Tokens[ClearIndex].Value = ""
								ClearedParents = ClearedParents + 1
							elseif Tokens[ClearIndex].Type == "Whitespace" then
								Tokens[ClearIndex].Value = ""
							end
							ClearIndex = ClearIndex + 1
						end
					end
				end
			else
				local Name = Token.Value
				local Replacement = Variables[Name]
				if Replacement and Replacement ~= "nil" and Replacement ~= "" then
					local IsAfterDot = false
					local PrevIndex = TokenIndex - 1
					while PrevIndex >= 1 and Tokens[PrevIndex].Type == "Whitespace" do
						PrevIndex = PrevIndex - 1
					end
					if PrevIndex >= 1 and (Tokens[PrevIndex].Type == "Symbol" or Tokens[PrevIndex].Type == "Operator") and (Tokens[PrevIndex].Value == "." or Tokens[PrevIndex].Value == ":") then
						IsAfterDot = true
					end

					if not IsAfterDot then
						local NextIndex = TokenIndex + 1
						while NextIndex <= TokenCount and Tokens[NextIndex].Type == "Whitespace" do
							NextIndex = NextIndex + 1
						end

						local ShouldReplace = true
						if NextIndex <= TokenCount and Tokens[NextIndex].Type == "Symbol" and Tokens[NextIndex].Value == "(" then
							if Name == "WaitForChild" or Name == "FindFirstChild" then
								ShouldReplace = false
							end
						end

						if ShouldReplace then
							local Parent, Child = StrMatch(Replacement, "^(.*)%.([%a_][%w_]*)$")
							if Parent and Child then
								local ResolvedParent = ResolveVariables(Parent, Variables)
								local FullPath = ResolvedParent .. "." .. Child
								local PathTokens = Tokenize(FullPath)
								if ValidatePath(PathTokens) then
									Token.Value = OptimizeGetService(FullPath)
								else
									Token.Value = FullPath
								end
							else
								local Resolved = ResolveVariables(Replacement, Variables)
								local ResolvedTokens = Tokenize(Resolved)
								if ValidatePath(ResolvedTokens) then
									Token.Value = OptimizeGetService(Resolved)
								else
									Token.Value = Resolved
								end
							end
						end
					end
				end
			end
		end
		TokenIndex = TokenIndex + 1
	end

	local Output = RemoveComments(Tokens)

	Output = StrReplace(Output, "([%w_]+)%s*:%s*FindFirstChild%s*%((.-)%)", function(Obj, Arg)
		local Unquoted = UnquoteString(Arg)
		if Unquoted and StrMatch(Unquoted, "^[%a_][%w_]*$") then
			return Obj .. ':FindFirstChild("' .. Unquoted .. '")'
		end
	end)

	Output = StrReplace(Output, '([%w_\"%)]+)%.([%a_][%w_]*)', function(Left, Right)
		if Right == "FireServer" or Right == "InvokeServer" or Right == "Fire" or Right == "Invoke" then
			return Left .. ":" .. Right
		end

		local Properties = {
			Name = true, ClassName = true, Parent = true, Value = true,
			UserId = true, Character = true, Team = true, Position = true,
			LocalPlayer = true, Hit = true, CFrame = true, Size = true,
			Color = true, Transparency = true, Anchored = true, CanCollide = true,
			Humanoid = true, HumanoidRootPart = true, Velocity = true, Health = true,
			MaxHealth = true, BodyVelocity = true, Backpack = true, PlayerGui = true
		}
		if Properties[Right] then
			return Left .. "." .. Right
		end

		local LeftTokens = Tokenize(Left)
		if #LeftTokens > 0 then
			local LastToken = LeftTokens[#LeftTokens]
			if LastToken.Value == ")" or LastToken.Value == "]" then
				return Left .. "." .. Right
			end
		end

		if TypeNames[Left] or Left == "pairs" or Left == "ipairs" or Left == "next" then
			return Left .. "." .. Right
		end

		return Left .. ':FindFirstChild("' .. Right .. '")'
	end)

	Output = StrReplace(Output, "Color3%.new%s*%(%s*(%d+)%s*,%s*(%d+)%s*,%s*(%d+)%s*%)", function(R, G, B)
		if ToNum(R) > 1 or ToNum(G) > 1 or ToNum(B) > 1 then
			return "Color3.fromRGB(" .. R .. ", " .. G .. ", " .. B .. ")"
		end
	end)

	return Output
end

local function SimplifyCode(Code: string): string
	return StrReplace(Code, "WaitForChild", "FindFirstChild")
end

local function AnalyzeScript(ScriptObj: Instance)
	if ScriptCache[ScriptObj] then return end

	local InStudio = RunService:IsStudio(RunService)
	local Success, Source = PCall(function()
		return InStudio and ScriptObj.Source or decompile(ScriptObj)
	end)

	if not Success or RawType(Source) ~= "string" or Source == "" then return end

	if Source:find("Instance%.new", 1, true) then
		ScriptCache[ScriptObj] = { Extracted = {}, Source = Source }
		return
	end

	local Variables = {}
	local LoopTargets = {}
	local Extracted = {}
	local FunctionParams = {}
	local FunctionArgs = {}

	local BasePath = OptimizeGetService(GetInstancePath(ScriptObj))
	local Lines = Source:split("\n")

	local ClientEventParams = {}
	for _, Line in IPairs(Lines) do
		local Clean = Line:gsub("%-%-.*$", "")
		for Params in Clean:gmatch("OnClientEvent%s*:[Cc]onnect%s*%(%s*function%s*%((.-)%)") do
			for Param in Params:gmatch("[%a_][%w_]*") do
				ClientEventParams[Param] = true
			end
		end
	end

	local function UsesClientEvent(Code: string): boolean
		local Args = Code:match(":[Ff]ire%s*%((.*)%)")
			or Code:match(":[Ii]nvoke%s*%((.*)%)")
			or Code:match(":[Ff]ire[Ss]erver%s*%((.*)%)")
			or Code:match(":[Ii]nvoke[Ss]erver%s*%((.*)%)")
		
		if not Args then return false end
		for Word in Args:gmatch("[%a_][%w_]*") do
			if ClientEventParams[Word] then
				return true
			end
		end
		return false
	end

	for _, Line in IPairs(Lines) do
		local Trimmed = Line:match("^%s*(.-)%s*$") or ""
		if Trimmed:sub(1, 2) == "--" then continue end

		local FuncName, RawParams = Trimmed:match("^local%s+function%s+([%a_][%w_]*)%s*%((.-)%)")
		if not FuncName then
			FuncName, RawParams = Trimmed:match("^function%s+([%a_][%w_]*)%s*%((.-)%)")
		end

		if FuncName and RawParams then
			local Params = {}
			for Param in RawParams:gmatch("[%a_][%w_]*") do
				TableInsert(Params, Param)
			end
			FunctionParams[FuncName] = Params
		else
			local Calls = FindCalls(Trimmed)
			for _, Call in IPairs(Calls) do
				if not GlobalNames[Call.name] and Call.name ~= "function" and Call.name ~= "local" and Call.name ~= "if" and Call.name ~= "elseif" then
					FunctionArgs[Call.name] = SplitArguments(Call.args)
				end
			end
		end
	end

	for FuncName, Params in Pairs(FunctionParams) do
		local Args = FunctionArgs[FuncName]
		if Args then
			for Index, Param in IPairs(Params) do
				local Arg = Args[Index]
				if Arg and Arg ~= "" then
					Variables[Param] = Arg
				end
			end
		end
	end

	local FunctionBodies = {}
	local CurrentFunc = nil
	local InBlockComment = false

	for _, Line in IPairs(Lines) do
		local Trimmed = Line:match("^%s*(.-)%s*$") or ""

		if not InBlockComment then
			Trimmed = Trimmed:gsub("%-%-%[%[.-%]%]", "")
		end

		if not InBlockComment and Trimmed:find("%-%-%[%[") then
			InBlockComment = true
			continue
		end

		if InBlockComment then
			if Trimmed:find("%]%]") then
				InBlockComment = false
			end
			continue
		end

		local DeclFunc = Trimmed:match("^local%s+function%s+([%a_][%w_]*)") or Trimmed:match("^function%s+([%a_][%w_]*)")

		if DeclFunc then
			CurrentFunc = DeclFunc
			FunctionBodies[CurrentFunc] = {}
			continue
		end

		if CurrentFunc and Trimmed == "end" then
			CurrentFunc = nil
			continue
		end

		if CurrentFunc then
			TableInsert(FunctionBodies[CurrentFunc], Line)
			continue
		end

		local VarName, VarValue = Trimmed:match("^%s*local%s+([%a_][%w_]*)%s*=%s*(.+)")
		if VarName and VarValue then
			Variables[VarName] = VarValue:gsub("%-%-.*$", ""):match("^%s*(.-)%s*$")
		else
			local ReassignName, ReassignValue = Trimmed:match("^%s*([%a_][%w_]*)%s*=%s*(.+)")
			if ReassignName and Variables[ReassignName] then
				Variables[ReassignName] = ReassignValue:gsub("%-%-.*$", ""):match("^%s*(.-)%s*$")
			end

			local MultiVarDecl = Trimmed:match("^%s*local%s+([%a_][%w_*,%s]*)$")
			if MultiVarDecl then
				for Var in MultiVarDecl:gmatch("[%a_][%w_]*") do
					Variables[Var] = Variables[Var] or ""
				end
			end
		end

		local LoopVar, LoopIter = Trimmed:match("^%s*for%s+([%a_][%w_*,%s]*)%s+in%s+(.+)$")
		if LoopVar and LoopIter then
			local PrimaryVar = LoopVar:match(",%s*([%a_][%w_]*)$")
			if PrimaryVar then
				local IteratorFunc =
					LoopIter:match("^[g]?[p]?airs%s*%((.+)%)%s*do%s*$")
					or LoopIter:match("^next%s*,%s*(.+)%s*do%s*$")
					or LoopIter:match("^(.+)%s*do%s*$")

				if IteratorFunc then
					local ResolvedIter = ResolveVariables(IteratorFunc, Variables)
					if ResolvedIter:match("%)%s*$")
						or ResolvedIter:match("%s*GetChildren%s*$")
						or ResolvedIter:match("%s*GetPlayers%s*$")
						or ResolvedIter:match("%s*children%s*$") then
						Variables[PrimaryVar] = PrimaryVar
						LoopTargets[PrimaryVar] = ResolvedIter
					else
						Variables[PrimaryVar] = ResolvedIter
					end
				end
			end
		end

		local CalledFunc = Trimmed:match("^([%a_][%w_]*)%s*%(")
		if CalledFunc and FunctionBodies[CalledFunc] then
			local RawArgs = Trimmed:match("^[%a_][%w_]*%s*%((.+)%)") or ""
			local PassedArgs = {}

			for Arg in RawArgs:gmatch("[^,%s]+") do
				TableInsert(PassedArgs, Arg)
			end

			for _, BodyLine in IPairs(FunctionBodies[CalledFunc]) do
				local ProcessedLine = BodyLine
				local Params = FunctionParams[CalledFunc] or {}

				for Index, ParamName in IPairs(Params) do
					local Replacement = PassedArgs[Index] or ""

					if ParamName == "..." then
						local Varargs = {}
						for VarIndex = Index, #PassedArgs do
							TableInsert(Varargs, PassedArgs[VarIndex])
						end
						Replacement = table.concat(Varargs, ", ")
					end

					local SafeParam = (ParamName:gsub("[%^%$%(%)%%%.%[%]%*%+%-%?]", "%%%1"))
					local SafeReplacement = (Replacement:gsub("%%", "%%%%"))

					ProcessedLine = ProcessedLine:gsub(
						"([%s,%(])" .. SafeParam .. "([%s,%)])",
						"%1" .. SafeReplacement .. "%2"
					)
				end

				for _, Trigger in IPairs(RemoteTriggers) do
					if ProcessedLine:find(Trigger, 1, true) then
						local CleanedLine = ProcessedLine:gsub("%-%-.*$", "")
						local ResolvedPayload = OptimizeScript(CleanedLine, Variables, BasePath):match("^%s*(.-)%s*$")
						
						if not UsesClientEvent(ResolvedPayload) then
							TableInsert(Extracted, ResolvedPayload)
						end
						break
					end
				end
			end
			continue
		end

		for _, Trigger in IPairs(RemoteTriggers) do
			if Line:find(Trigger, 1, true) then
				local CleanedLine = Line:gsub("%-%-.*$", "")
				local ResolvedPayload = OptimizeScript(CleanedLine, Variables, BasePath):match("^%s*(.-)%s*$")

				if UsesClientEvent(ResolvedPayload) then
					break
				end

				local TargetVar =
					ResolvedPayload:match(":FireServer%s*%(([%a_][%w_]*)")
					or ResolvedPayload:match(":InvokeServer%s*%(([%a_][%w_]*)")
					or ResolvedPayload:match(":Fire%s*%(([%a_][%w_]*)")
					or ResolvedPayload:match(":Invoke%s*%(([%a_][%w_]*)")

				if TargetVar and LoopTargets[TargetVar] and not ResolvedPayload:find("ipairs", 1, true) then
					local WrappedCode = ("do\n\tfor _, %s in ipairs(%s) do\n\t\t%s\n\tend\nend"):format(
						TargetVar,
						LoopTargets[TargetVar],
						ResolvedPayload
					)
					TableInsert(Extracted, WrappedCode)
				else
					TableInsert(Extracted, ResolvedPayload)
				end
				break
			end
		end
	end

	ScriptCache[ScriptObj] = {
		Extracted = Extracted,
		Source = Source
	}
end

local function ClearPanel(Panel: Instance)
	for _, Child in IPairs(Panel:GetChildren()) do
		if Child:IsA("Frame") then
			Child:Destroy()
		end
	end
end

local function ClearIndicators(Container: Instance)
	ClearPanel(Container)
	Container.Size = UDim2.new(0, 5, 0, 18)
	local Indicator = Create("Frame", {
		Name = "IndicatorCircle",
		BackgroundColor3 = Color3.fromRGB(150, 150, 150),
		BorderSizePixel = 0,
		Size = UDim2.new(0, 5, 0, 5),
		ZIndex = 3
	})
	Create("UICorner", {CornerRadius = UDim.new(0.5, 0), Parent = Indicator})
	Indicator.Parent = Container
end

local function UpdateSearch()
	local Query = StrLower(SearchBox.Text)
	if Query == "" then
		for _, Item in IPairs(ScriptList) do
			Item.Log.Visible = true
			Item.Log.LayoutOrder = Item.OriginalOrder
		end
		return
	end

	for _, Item in IPairs(ScriptList) do
		local Relevance = SearchRelevance(Item, Query)
		if Relevance > 0 then
			Item.Log.Visible = true
			Item.Log.LayoutOrder = -Relevance
		else
			Item.Log.Visible = false
		end
	end
end

TableInsert(AllConnections, SearchBox:GetPropertyChangedSignal("Text"):Connect(UpdateSearch))

local function GetDisplayName(ScriptName: string, IsModule: boolean, Count: number): string
	local Prefix = IsModule and "[M]" or "[LS]"
	if Count == 0 then
		return Prefix .. " " .. ScriptName
	else
		return Prefix .. " " .. ScriptName .. " (" .. (Count + 1) .. ")"
	end
end

local function AddScript(ScriptObj: Instance)
	if IsInCore(ScriptObj) then return end

	for _, Item in IPairs(ScriptList) do
		if Item.ScriptObj == ScriptObj then return end
	end

	local ScriptName = ScriptObj.Name
	local IsModule = ScriptObj:IsA("ModuleScript")
	local ExistingCount = 0
	
	for _, Item in IPairs(ScriptList) do
		if Item.ScriptObj.Name == ScriptName then
			ExistingCount = ExistingCount + 1
		end
	end

	local DisplayName = GetDisplayName(ScriptName, IsModule, ExistingCount)

	local Frame = Create("Frame", {
		LayoutOrder = NextLayout,
		Name = "RemoteTemplate",
		Parent = ScriptsList,
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 132, 0, 22)
	})

	local IndicatorContainer = Create("Frame", {
		Name = "IndicatorContainer",
		Parent = Frame,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 2, 0, 2),
		Size = UDim2.new(0, 5, 0, 18),
		ZIndex = 3
	})

	local IndicatorLayout = Create("UIListLayout", {
		Parent = IndicatorContainer,
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 2)
	})

	ClearIndicators(IndicatorContainer)

	local TextLabel = Create("TextLabel", {
		TextTruncate = Enum.TextTruncate.AtEnd,
		Name = "Text",
		Parent = Frame,
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 12, 0, 2),
		Size = UDim2.new(0, 116, 0, 18),
		ZIndex = 2,
		Font = Enum.Font.Gotham,
		Text = DisplayName,
		TextColor3 = Color3.fromRGB(220, 220, 220),
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left
	})

	local Button = Create("TextButton", {
		Name = "Button",
		Parent = Frame,
		BackgroundColor3 = Color3.fromRGB(24, 24, 24),
		BorderColor3 = Color3.fromRGB(40, 40, 40),
		Position = UDim2.new(0, 0, 0, 2),
		Size = UDim2.new(0, 132, 0, 18),
		AutoButtonColor = false,
		Font = Enum.Font.Gotham,
		Text = "",
		TextColor3 = Color3.new(0, 0, 0),
		TextSize = 14
	})
	Create("UICorner", {CornerRadius = UDim.new(0, 3), Parent = Button})

	local Item = {
		ScriptObj = ScriptObj,
		Log = Frame,
		Button = Button,
		TextLabel = TextLabel,
		IndicatorContainer = IndicatorContainer,
		GenScript = "Click to scan script events...",
		FullScript = "",
		OriginalOrder = NextLayout,
		ScriptNameLower = StrLower(ScriptName),
		LogNameLower = StrLower(DisplayName),
		ModuleNameLower = IsModule and StrLower(ScriptName) or "",
		IsSelected = false
	}

	TableInsert(ScriptList, Item)

	table.sort(ScriptList, function(A, B)
		if A.ScriptNameLower == B.ScriptNameLower then
			local CountA = 0
			local CountB = 0
			for _, Script in IPairs(ScriptList) do
				if Script.ScriptNameLower == A.ScriptNameLower then
					CountA = CountA + 1
				end
				if Script.ScriptNameLower == B.ScriptNameLower then
					CountB = CountB + 1
				end
			end
			return CountA < CountB
		end
		return A.ScriptNameLower < B.ScriptNameLower
	end)

	for Index = 1, #ScriptList do
		local Script = ScriptList[Index]
		Script.Log.LayoutOrder = Index
		Script.OriginalOrder = Index
		local SameNameCount = 0
		for PrevIndex = 1, Index - 1 do
			if ScriptList[PrevIndex].ScriptNameLower == Script.ScriptNameLower then
				SameNameCount = SameNameCount + 1
			end
		end
		local UpdatedName = GetDisplayName(Script.ScriptObj.Name, Script.ScriptObj:IsA("ModuleScript"), SameNameCount)
		Script.TextLabel.Text = UpdatedName
		Script.LogNameLower = StrLower(UpdatedName)
	end

	local SearchQuery = StrLower(SearchBox.Text)
	if SearchQuery ~= "" then
		local Relevance = SearchRelevance(Item, SearchQuery)
		Frame.Visible = Relevance > 0
		if Relevance > 0 then
			Frame.LayoutOrder = -Relevance
		end
	end

	TableInsert(AllConnections, Button.MouseButton1Click:Connect(function()
		if CurrentSelection then
			local Previous = CurrentSelection
			Previous.IsSelected = false
			if Previous.Log then
				if Previous.Button then
					ApplyTween(Previous.Button, {BackgroundColor3 = COLOR_NORMAL})
				end
				if Previous.IndicatorContainer then
					ClearIndicators(Previous.IndicatorContainer)
					if Previous.TextLabel then
						Previous.TextLabel.Position = UDim2.new(0, 12, 0, 2)
						Previous.TextLabel.Size = UDim2.new(0, 136, 0, 18)
					end
				end
			end
			if CurrentSelection == Item then
				CurrentSelection = nil
				EventsOutput.Text = "Select a script from the scripts logs."
				EventsView.CanvasSize = UDim2.fromOffset(0, 0)
				return
			end
		end

		CurrentSelection = Item
		Item.IsSelected = true
		ApplyTween(Button, {BackgroundColor3 = COLOR_SELECTED})

		local function DisplayEvents(CachedData)
			ClearPanel(IndicatorContainer)
			local EventTypes = {}
			
			for _, Line in IPairs(CachedData.Extracted or {}) do
				if StrFind(Line, "FireServer", 1, true) then
					EventTypes[":FireServer"] = Color3.fromRGB(250, 210, 50)
				elseif StrFind(Line, "InvokeServer", 1, true) then
					EventTypes[":InvokeServer"] = Color3.fromRGB(240, 100, 240)
				elseif StrFind(Line, "Fire", 1, true) then
					EventTypes[":Fire"] = Color3.fromRGB(50, 220, 110)
				elseif StrFind(Line, "Invoke", 1, true) then
					EventTypes[":Invoke"] = Color3.fromRGB(255, 100, 100)
				end
			end

			local TypeCount = 0
			for EventType, Color in Pairs(EventTypes) do
				TypeCount = TypeCount + 1
				local Circle = Create("Frame", {
					Name = "IndicatorCircle",
					BackgroundColor3 = Color,
					BorderSizePixel = 0,
					Size = UDim2.new(0, 5, 0, 5),
					ZIndex = 3
				})
				Create("UICorner", {CornerRadius = UDim.new(0.5, 0), Parent = Circle})
				Circle.Parent = IndicatorContainer
			end

			if TypeCount > 0 then
				local Width = (TypeCount * 5) + ((TypeCount - 1) * 2)
				IndicatorContainer.Size = UDim2.new(0, Width, 0, 18)
				TextLabel.Position = UDim2.new(0, 8 + Width, 0, 2)
				TextLabel.Size = UDim2.new(0, 144 - Width, 0, 18)
			else
				IndicatorContainer.Size = UDim2.new(0, 5, 0, 18)
				TextLabel.Position = UDim2.new(0, 12, 0, 2)
				TextLabel.Size = UDim2.new(0, 136, 0, 18)

				local NoEvents = Create("Frame", {
					Name = "IndicatorCircle",
					BackgroundColor3 = Color3.fromRGB(230, 40, 40),
					BorderSizePixel = 0,
					Size = UDim2.new(0, 5, 0, 5),
					ZIndex = 3
				})
				Create("UICorner", {CornerRadius = UDim.new(0.5, 0), Parent = NoEvents})
				NoEvents.Parent = IndicatorContainer
			end
		end

		if not ScriptCache[ScriptObj] then
			AnalyzeScript(ScriptObj)
			local CachedData = ScriptCache[ScriptObj]
			if CachedData then
				Item.FullScript = CachedData.Source
				
				local Lines = {}
				if #(CachedData.Extracted or {}) > 0 then
					for _, Line in IPairs(CachedData.Extracted) do
						local Label = ""
						if StrFind(Line, "FireServer", 1, true) then
							Label = "-- FireServer() Call"
						elseif StrFind(Line, "InvokeServer", 1, true) then
							Label = "-- InvokeServer() Call"
						elseif StrFind(Line, "Fire", 1, true) then
							Label = "-- Fire() Call"
						elseif StrFind(Line, "Invoke", 1, true) then
							Label = "-- Invoke() Call"
						else
							Label = "-- Event Call"
						end
						TableInsert(Lines, Label .. "\n" .. Line)
					end
				end

				if #Lines > 0 then
					Item.GenScript = table.concat(Lines, "\n\n")
					
					if CurrentSelection == Item then
						DisplayEvents(CachedData)
						EventsOutput.Text = SimplifyCode(Item.GenScript)
						local TextSize = TextService:GetTextSize(EventsOutput.Text, EventsOutput.TextSize, EventsOutput.Font, Vector2.new(EventsView.AbsoluteSize.X - 12, math.huge))
						EventsView.CanvasSize = UDim2.fromOffset(0, TextSize.Y + 16)
					end
				else
					Item.GenScript = "-- No events found in this script."
					if CurrentSelection == Item then
						DisplayEvents({Extracted = {}})
						EventsOutput.Text = Item.GenScript
						local TextSize = TextService:GetTextSize(EventsOutput.Text, EventsOutput.TextSize, EventsOutput.Font, Vector2.new(EventsView.AbsoluteSize.X - 12, math.huge))
						EventsView.CanvasSize = UDim2.fromOffset(0, TextSize.Y + 16)
					end
				end
			else
				Item.GenScript = "-- Failed to decompile this script."
				if CurrentSelection == Item then
					DisplayEvents({Extracted = {}})
					EventsOutput.Text = Item.GenScript
					local TextSize = TextService:GetTextSize(EventsOutput.Text, EventsOutput.TextSize, EventsOutput.Font, Vector2.new(EventsView.AbsoluteSize.X - 12, math.huge))
					EventsView.CanvasSize = UDim2.fromOffset(0, TextSize.Y + 16)
				end
			end
		else
			local CachedData = ScriptCache[ScriptObj]
			
			local Lines = {}
			if #(CachedData.Extracted or {}) > 0 then
				for _, Line in IPairs(CachedData.Extracted) do
					local Label = ""
					if StrFind(Line, "FireServer", 1, true) then
						Label = "-- FireServer() Call"
					elseif StrFind(Line, "InvokeServer", 1, true) then
						Label = "-- InvokeServer() Call"
					elseif StrFind(Line, "Fire", 1, true) then
						Label = "-- Fire() Call"
					elseif StrFind(Line, "Invoke", 1, true) then
						Label = "-- Invoke() Call"
					else
						Label = "-- Event Call"
					end
					TableInsert(Lines, Label .. "\n" .. Line)
				end
			end

			Item.GenScript = #Lines > 0 and table.concat(Lines, "\n\n") or "-- No events found in this script."
			EventsOutput.Text = SimplifyCode(Item.GenScript)
			local TextSize = TextService:GetTextSize(EventsOutput.Text, EventsOutput.TextSize, EventsOutput.Font, Vector2.new(EventsView.AbsoluteSize.X - 12, math.huge))
			EventsView.CanvasSize = UDim2.fromOffset(0, TextSize.Y + 16)
			DisplayEvents(CachedData)
		end
	end))

	TableInsert(AllConnections, Button.MouseEnter:Connect(function()
		if Item.IsSelected then
			ApplyTween(Button, {BackgroundColor3 = COLOR_SELECTED_HOVER})
		else
			ApplyTween(Button, {BackgroundColor3 = COLOR_HOVER})
		end
		ApplyTween(TextLabel, {TextColor3 = Color3.fromRGB(255, 255, 255)})
	end))

	TableInsert(AllConnections, Button.MouseLeave:Connect(function()
		if Item.IsSelected then
			ApplyTween(Button, {BackgroundColor3 = COLOR_SELECTED})
		else
			ApplyTween(Button, {BackgroundColor3 = COLOR_NORMAL})
		end
		ApplyTween(TextLabel, {TextColor3 = Color3.fromRGB(220, 220, 220)})
	end))

	NextLayout = NextLayout - 1

	TableInsert(AllConnections, ScriptsLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		ScriptsList.CanvasSize = UDim2.fromOffset(0, ScriptsLayout.AbsoluteContentSize.Y)
	end))
end

local function RemoveScript(ScriptObj: Instance)
	for Index, Item in IPairs(ScriptList) do
		if Item.ScriptObj == ScriptObj then
			if CurrentSelection == Item then
				CurrentSelection = nil
				EventsOutput.Text = "Select a script from the scripts logs."
				EventsView.CanvasSize = UDim2.fromOffset(0, 0)
			end
			if Item.Log then
				Item.Log:Destroy()
			end
			TableRemove(ScriptList, Index)
			for UpdateIndex = Index, #ScriptList do
				ScriptList[UpdateIndex].Log.LayoutOrder = UpdateIndex
				ScriptList[UpdateIndex].OriginalOrder = UpdateIndex
				local SameNameCount = 0
				for PrevIndex = 1, UpdateIndex - 1 do
					if ScriptList[PrevIndex].ScriptNameLower == ScriptList[UpdateIndex].ScriptNameLower then
						SameNameCount = SameNameCount + 1
					end
				end
				local UpdatedName = GetDisplayName(ScriptList[UpdateIndex].ScriptObj.Name, ScriptList[UpdateIndex].ScriptObj:IsA("ModuleScript"), SameNameCount)
				ScriptList[UpdateIndex].TextLabel.Text = UpdatedName
				ScriptList[UpdateIndex].LogNameLower = StrLower(UpdatedName)
			end
			break
		end
	end
end

