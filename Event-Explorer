local function WatchForChanges()
	PCCall(function()
		for _, Service in IPairs(game:GetChildren()) do
			local ServiceClass = Service.ClassName
			if ServiceClass ~= "CoreGui" and ServiceClass ~= "CorePackages" and ServiceClass ~= "LocalSaves" then
				TableInsert(AllConnections, Service.DescendantAdded:Connect(function(Descendant)
					if (Descendant:IsA("LocalScript") or Descendant:IsA("ModuleScript")) and not IsInCore(Descendant) then
						AddScript(Descendant)
					end
				end))
				TableInsert(AllConnections, Service.DescendantRemoving:Connect(function(Descendant)
					if Descendant:IsA("LocalScript") or Descendant:IsA("ModuleScript") then
						RemoveScript(Descendant)
					end
				end))
			end
		end
	end)
end

