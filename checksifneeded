-- https://real-rblxscripts.github.io/load
local blacklistedExecutors = {
    ["solara"] = true,
    ["xeno"] = true,
}
if identifyexecutor then

    local rawName, version = identifyexecutor()
    local currentExecutorName = string.lower(tostring(rawName))

    if blacklistedExecutors[currentExecutorName] then
        -- Kick the local player from the client side
        local Players = game:Service("Players")
        local localPlayer = Players.LocalPlayer
        
        if localPlayer then
            localPlayer:Kick("Unsupported!")
        end
    end
end
