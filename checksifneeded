-- https://real-rblxscripts.github.io/load
local blacklistedExecutors = { "solara", "xeno", "vega x" }
local getExec = identifyexecutor or getexecutorname or getexecname
if getExec then
    local rawName = tostring(getExec()):lower()
    for _, name in ipairs(blacklistedExecutors) do
        if rawName:find(name) then
            local Players = game:GetService("Players")
            local localPlayer = Players.LocalPlayer
            if localPlayer then
                localPlayer:Kick("RBLXScripts> Unsupported Executor!")
            end
            break
        end
    end
end
